{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaFeiYu plugin market index",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "maxLength": 40 },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "version", "kind", "name", "description", "author", "permissions", "harness", "size", "sha256", "manifest", "wasm"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][\\w.-]+)?$", "maxLength": 40 },
          "kind": { "const": "script" },
          "name": { "type": "string", "maxLength": 80 },
          "labels": {
            "type": "object",
            "properties": {
              "zh": { "type": "string", "maxLength": 80 },
              "en": { "type": "string", "maxLength": 80 }
            }
          },
          "description": { "type": "string", "maxLength": 240 },
          "author": { "type": "string", "maxLength": 80 },
          "homepage": { "type": "string", "maxLength": 300 },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "maxItems": 12 },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["pet", "bridge", "net"] }
          },
          "harness": { "type": "string", "maxLength": 64 },
          "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "manifest": { "type": "string", "maxLength": 200 },
          "wasm": { "type": "string", "maxLength": 200 },
          "source": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}